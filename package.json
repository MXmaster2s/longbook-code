{
  "name": "longbook",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "description": "longbook — a financial memory for your AI: your recurring money as a plain folder of files you own, readable and writable by the AI you already use.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint:transform": "node scripts/lint-transform.mjs",
    "lint:comments": "node scripts/lint-comments.mjs",
    "guard:name": "node scripts/name-guard.mjs",
    "telemetry:names": "node scripts/telemetry-names.mjs",
    "telemetry:coverage": "node scripts/telemetry-names.mjs --coverage --strict",
    "guard:tree": "node scripts/tree-guard.mjs",
    "guard:leak": "node scripts/leak-check.mjs",
    "guard:history": "node scripts/history-guard.mjs",
    "guard:rls": "tsx scripts/guard-rls.mts",
    "vault:contract": "tsx scripts/gen-vault-contract.mts",
    "vault:contract:check": "tsx scripts/gen-vault-contract.mts --check",
    "design:tokens": "tsx scripts/gen-design-tokens.mts",
    "design:tokens:check": "tsx scripts/gen-design-tokens.mts --check",
    "site:fonts": "tsx scripts/gen-site-fonts.mts",
    "hosted:engine": "tsx scripts/gen-hosted-engine.mts",
    "hosted:engine:check": "tsx scripts/gen-hosted-engine.mts --check",
    "hosted:deploy": "tsx scripts/deploy-mcp.mts",
    "hosted:verify": "tsx scripts/hosted-verify.mts",
    "account:deploy": "tsx scripts/deploy-delete-account.mts",
    "function:deploy": "tsx scripts/deploy-function.mts",
    "deploy:servers": "zsh scripts/deploy-servers.sh",
    "asc:iap": "tsx scripts/asc-iap.mts",
    "asc:subscription": "tsx scripts/asc-subscription.mts",
    "asc:builds": "tsx scripts/asc-builds.mts",
    "asc:testflight": "tsx scripts/asc-testflight.mts",
    "asc:listing": "tsx scripts/asc-listing.mts",
    "review:account": "tsx scripts/review-account.mts",
    "asc:screenshots": "tsx scripts/asc-screenshots.mts",
    "store:images": "tsx scripts/store-images.mts",
    "store:header": "tsx scripts/store-header.mts",
    "vault:convert": "tsx scripts/vault-convert-v3.mts",
    "release:mas": "tsx scripts/release-mas.mts",
    "release:ios": "tsx scripts/release-ios.mts",
    "asc:provision": "tsx scripts/asc-provision.mts",
    "local:server": "tsx scripts/gen-local-server.mts",
    "local:server:check": "tsx scripts/gen-local-server.mts --check",
    "proof:agent": "tsx scripts/agent-import-run.mts",
    "fixtures:statements": "tsx scripts/gen-statement-fixtures.mts",
    "demo:vault": "tsx scripts/demo-vault.mts",
    "fixtures:statements:check": "tsx scripts/gen-statement-fixtures.mts --check",
    "site:router": "tsx scripts/gen-mcp-router.mts",
    "site:router:check": "tsx scripts/gen-mcp-router.mts --check",
    "site:consent": "tsx scripts/gen-consent-bundle.mts",
    "site:consent:check": "tsx scripts/gen-consent-bundle.mts --check",
    "site:viewer": "tsx scripts/gen-share-viewer.mts",
    "site:viewer:check": "tsx scripts/gen-share-viewer.mts --check",
    "site:analytics": "tsx scripts/gen-analytics-bundle.mts",
    "site:analytics:check": "tsx scripts/gen-analytics-bundle.mts --check",
    "metrics": "tsx scripts/metrics.mts",
    "diagnostics:pull": "tsx scripts/app-diagnostics.mts",
    "site:media-kit": "swift scripts/media-kit.swift && tsx scripts/gen-media-kit.mts",
    "site:media-kit:text": "tsx scripts/gen-media-kit.mts",
    "site:media-kit:check": "tsx scripts/gen-media-kit.mts --check",
    "plugin:claude": "tsx scripts/gen-claude-plugin.mts",
    "plugin:claude:check": "tsx scripts/gen-claude-plugin.mts --check",
    "plugin:claude:publish": "zsh scripts/publish-claude-plugin.sh",
    "release": "tsx scripts/gen-release.mts",
    "release:check": "tsx scripts/gen-release.mts --check",
    "versions": "tsx scripts/versions.mts",
    "versions:live": "tsx scripts/versions.mts --live",
    "npm:publish": "tsx scripts/publish-npm.mts",
    "registry:publish": "tsx scripts/publish-registry.mts",
    "device:install": "tsx scripts/device-install.mts",
    "site:pages": "tsx scripts/gen-site-pages.mts",
    "site:pages:check": "tsx scripts/gen-site-pages.mts --check",
    "site:pages:lint": "tsx scripts/gen-site-pages.mts --lint",
    "site:pages:test": "tsx --test scripts/site-pages/*.test.mts",
    "site:images": "tsx scripts/site-images.mts",
    "site:og": "tsx scripts/site-og.mts",
    "site:media": "tsx scripts/site-media.mts",
    "site:deploy": "tsx scripts/site-deploy.mts",
    "email:preview": "tsx scripts/preview-purchase-email.mts",
    "email:test": "tsx --test scripts/purchase-email.test.mts scripts/confirm-purchase.test.mts scripts/auth-emails.test.mts scripts/account-notice.test.mts scripts/auth-email.test.mts",
    "auth-emails": "tsx scripts/auth-emails.mts",
    "auth-emails:check": "tsx scripts/auth-emails.mts --check",
    "auth-hook": "tsx scripts/auth-hook.mts",
    "sessions:test": "tsx --test scripts/sessions.test.mts",
    "review:test": "tsx --test scripts/review-sign-in.test.mts",
    "cloud:test": "tsx --test scripts/cloud-subscription.test.mts",
    "statements:test": "tsx --test scripts/statement-shares.test.mts scripts/licence-seats.test.mts",
    "changelog:check": "tsx scripts/changelog-check.mts",
    "vault:repair": "tsx scripts/gen-vault-contract.mts --repair",
    "higgsfield:seedance": "tsx examples/higgsfield-seedance/index.ts",
    "asc:price": "tsx scripts/asc-licence-price.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@higgsfield/client": "0.2.6",
    "@supabase/supabase-js": "2.112.3",
    "esbuild": "^0.28.1",
    "posthog-js": "1.434.3"
  }
}
