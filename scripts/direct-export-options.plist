<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The direct Mac channel: Developer ID signing for a notarised DMG from longbook.app.
	     Automatic: the Developer ID profile carrying iCloud is Xcode-managed, and a manual
	     export refuses one. -->
	<key>method</key>
	<string>developer-id</string>
	<key>teamID</key>
	<string>27F9SH746V</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Developer ID copies talk to the production iCloud container, never development. -->
	<key>iCloudContainerEnvironment</key>
	<string>Production</string>
	<key>destination</key>
	<string>export</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
