// The consent page's script, generated: bundles consent.src.mts with the pinned
// supabase-js into the one file the static site serves. Committed and CI-checked.
import { buildSync } from 'esbuild'
import { readFileSync, writeFileSync, existsSync } from 'node:fs'
import { join } from 'node:path'
import { fileURLToPath } from 'node:url'

const ROOT = fileURLToPath(new URL('..', import.meta.url))
const SRC = join(ROOT, 'apps/longbook-site/oauth/consent/consent.src.mts')
const OUT = join(ROOT, 'apps/longbook-site/oauth/consent/consent.js')
const CHECK = process.argv.includes('--check')

const bundle = buildSync({
  entryPoints: [SRC],
  bundle: true,
  format: 'iife',
  platform: 'browser',
  target: 'es2020',
  minify: true,
  legalComments: 'none',
  write: false,
})

const out = `// generated by scripts/gen-consent-bundle.mts — do not edit. Regenerate: npm run site:consent.\n${bundle.outputFiles[0]?.text ?? ''}`

if (CHECK) {
  if (!existsSync(OUT) || readFileSync(OUT, 'utf8') !== out) {
    console.error(`consent bundle drifted: ${OUT.slice(ROOT.length)}`)
    console.error('run: npm run site:consent')
    process.exit(1)
  }
  console.log('consent bundle — in sync.')
} else {
  writeFileSync(OUT, out)
  console.log(`wrote ${OUT.slice(ROOT.length)} (${Math.round(out.length / 1024)} KB).`)
}
