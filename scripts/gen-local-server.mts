#!/usr/bin/env -S npx tsx
// Bundles the stdio MCP server into one file the Mac app ships in its Resources, so
// a written client config points at the app bundle, never at a repo. Run with
// --check to verify the committed copy matches. Regenerate: npm run local:server.
import { build } from 'esbuild'
import { readFileSync, writeFileSync, existsSync } from 'node:fs'
import { join, dirname } from 'node:path'
import { fileURLToPath } from 'node:url'
import { CONTRACT_REVISION } from '../packages/core/src/contract'
import { revisionDrift, workspaceAliases } from './workspace-bundle.mts'

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..')
const OUT = join(ROOT, 'apps/longbook/Resources/longbook-mcp.mjs')
// The npm bin is the same bytes behind a shebang, so `npx @longbook/mcp` and the Mac
// app run one identical server. Published at launch; prepared and checked from now.
const BIN = join(ROOT, 'packages/mcp/bin/longbook-mcp.mjs')
const CHECK = process.argv.includes('--check')

const bundle = await build({
  entryPoints: [join(ROOT, 'packages/mcp/src/server.ts')],
  // The core beside this script, whatever node_modules links to.
  alias: workspaceAliases(ROOT),
  bundle: true,
  format: 'esm',
  platform: 'node',
  target: 'node18',
  minify: true,
  // Deploy tooling and editors read artifacts line-wise; capped lines stay faithful.
  lineLimit: 500,
  write: false,
  legalComments: 'none',
  banner: { js: '// generated by scripts/gen-local-server.mts — do not edit. Regenerate: npm run local:server.' },
})

const out = (bundle.outputFiles[0]?.text ?? '') + '\n'
const binOut = '#!/usr/bin/env node\n' + out

// A build against another checkout's core carries two revisions; never write or pass one.
const built = revisionDrift(out, CONTRACT_REVISION)
if (built) {
  console.error(`local server build ${built}`)
  process.exit(1)
}

if (CHECK) {
  const copies: [string, string][] = [
    [OUT, out],
    [BIN, binOut],
  ]
  const drifted = copies.find(([path, want]) => !existsSync(path) || readFileSync(path, 'utf8') !== want)
  if (drifted) {
    const [path] = drifted
    const why = existsSync(path) ? revisionDrift(readFileSync(path, 'utf8'), CONTRACT_REVISION) : null
    console.error(`local server bundle drifted${why ? ` — ${why}` : ''} — run: npm run local:server`)
    process.exit(1)
  }
  console.log('local server bundle — in sync (app copy + npm bin).')
} else {
  writeFileSync(OUT, out)
  writeFileSync(BIN, binOut, { mode: 0o755 })
  console.log(`wrote ${OUT.slice(ROOT.length)} and ${BIN.slice(ROOT.length)} (${Math.round(out.length / 1024)} KB).`)
}
