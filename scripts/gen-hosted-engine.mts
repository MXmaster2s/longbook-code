// The hosted server's arithmetic, generated: bundles packages/mcp's dispatcher (and
// core beneath it) into one dependency-free module the Deno function imports, with
// the vault contract embedded. Committed and CI-checked, like the contract copies.
import { buildSync } from 'esbuild'
import { readFileSync, writeFileSync, existsSync } from 'node:fs'
import { join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { CONTRACT_REVISION } from '../packages/core/src/contract'
import { revisionDrift, workspaceAliases } from './workspace-bundle.mts'

const ROOT = fileURLToPath(new URL('..', import.meta.url))
const OUT = join(ROOT, 'supabase/functions/mcp/engine.mjs')
const CHECK = process.argv.includes('--check')

const bundle = buildSync({
  stdin: {
    contents:
      "export { handleRpc, RpcFailure } from './rpc.ts'\n" +
      "export { parseHints, parseVault, VaultReadError } from './parse.ts'\n" +
      "export { RateLimiter } from './rateLimit.ts'\n" +
      "export { failureBody } from './failure.ts'\n" +
      "export { digest, reorganiseInstructions, REORGANISE_SHAPE, takeProposals } from './reorganise.ts'\n" +
      "export { guideSection } from '@longbook/core'\n",
    resolveDir: join(ROOT, 'packages/mcp/src'),
    loader: 'ts',
  },
  // The core beside this script, whatever node_modules links to.
  alias: workspaceAliases(ROOT),
  bundle: true,
  format: 'esm',
  platform: 'node',
  target: 'es2022',
  // Literal UTF-8, not \uXXXX escapes: deploy tooling round-trips this file through
  // JSON, which decodes escapes to literals — matching bytes beats matching spellings.
  charset: 'utf8',
  // Minified on purpose: the artifact is generated and CI-checked, never read by hand,
  // and error strings survive minification — only stack symbols pay.
  minify: true,
  // Deploy tooling reads the artifact line-wise and silently truncates very long lines;
  // capping them keeps every read byte-faithful.
  lineLimit: 500,
  write: false,
  legalComments: 'none',
})

const llms = readFileSync(join(ROOT, 'packages/core/contract/llms.txt'), 'utf8')
const schema = readFileSync(join(ROOT, 'packages/core/contract/longbook.schema.json'), 'utf8')

// Same line-length cap as the bundle above, for the same reason: one JSON.stringify
// of a whole contract is a single multi-kilobyte line.
const chunked = (text: string): string =>
  (text.match(/[\s\S]{1,800}/g) ?? ['']).map((part) => JSON.stringify(part)).join(' +\n  ')

const out = [
  '// generated by scripts/gen-hosted-engine.mts — do not edit. Regenerate: npm run hosted:engine.',
  bundle.outputFiles[0]?.text ?? '',
  `export const LLMS_TXT = ${chunked(llms)}`,
  `export const SCHEMA_JSON = ${chunked(schema)}`,
  '',
].join('\n')

// A build against another checkout's core carries two revisions; never write or pass one.
const built = revisionDrift(out, CONTRACT_REVISION)
if (built) {
  console.error(`hosted engine build ${built}`)
  process.exit(1)
}

if (CHECK) {
  const committed = existsSync(OUT) ? readFileSync(OUT, 'utf8') : null
  if (committed !== out) {
    const why = committed === null ? null : revisionDrift(committed, CONTRACT_REVISION)
    console.error(`hosted engine drifted${why ? ` — ${why}` : ''}: ${OUT.slice(ROOT.length)}`)
    console.error('run: npm run hosted:engine')
    process.exit(1)
  }
  console.log('hosted engine — in sync.')
} else {
  writeFileSync(OUT, out)
  console.log(`wrote ${OUT.slice(ROOT.length)} (${Math.round(out.length / 1024)} KB).`)
}
