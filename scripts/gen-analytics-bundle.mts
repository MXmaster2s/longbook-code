// The site's measurement script, generated: bundles analytics.src.mts with the pinned
// posthog-js (its no-external build, which loads nothing else at run time) into the one file
// the static pages include. Committed and CI-checked. Regenerate: npm run site:analytics.
import { buildSync } from 'esbuild'
import { readFileSync, writeFileSync, existsSync } from 'node:fs'
import { join } from 'node:path'
import { fileURLToPath } from 'node:url'

const ROOT = fileURLToPath(new URL('..', import.meta.url))
const SRC = join(ROOT, 'apps/longbook-site/analytics.src.mts')
const OUT = join(ROOT, 'apps/longbook-site/analytics.js')
const CHECK = process.argv.includes('--check')

const bundle = buildSync({
  entryPoints: [SRC],
  bundle: true,
  format: 'iife',
  platform: 'browser',
  target: 'es2020',
  minify: true,
  legalComments: 'none',
  write: false,
})

const out = `// generated by scripts/gen-analytics-bundle.mts — do not edit. Regenerate: npm run site:analytics.\n${bundle.outputFiles[0]?.text ?? ''}`

if (CHECK) {
  if (!existsSync(OUT) || readFileSync(OUT, 'utf8') !== out) {
    console.error(`analytics bundle drifted: ${OUT.slice(ROOT.length)}`)
    console.error('run: npm run site:analytics')
    process.exit(1)
  }
  console.log('analytics bundle — in sync.')
} else {
  writeFileSync(OUT, out)
  console.log(`wrote ${OUT.slice(ROOT.length)} (${Math.round(out.length / 1024)} KB).`)
}
