// The help articles from apps/longbook-site-content/help, for the support function and
// the app's reader. Website-only text (scripts/help-markers.mts) is left out of
// help-articles.json, for App Store builds, and kept in help-articles-web.json, for the direct
// Mac build. Committed and CI-checked. Regenerate: npm run help:articles.
import { readdirSync, readFileSync, writeFileSync, existsSync } from 'node:fs'
import { join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { fullText, markerProblems, restrictedText } from './help-markers.mts'

const ROOT = fileURLToPath(new URL('..', import.meta.url))
const DIR = join(ROOT, 'apps/longbook-site-content/help')
const SERVER = join(ROOT, 'supabase/functions/_shared/help-articles.ts')
const APP = join(ROOT, 'apps/longbook/Resources/help-articles.json')
const APP_WEB = join(ROOT, 'apps/longbook/Resources/help-articles-web.json')
const CHECK = process.argv.includes('--check')

interface Article { slug: string; title: string; body: string }

function article(slug: string, text: string, name: string): Article {
  const trimmed = text.trim()
  const title = trimmed.match(/^# (.+)$/m)?.[1]?.trim()
  if (!title) throw new Error(`${name} has no # title`)
  return { slug, title, body: trimmed.replace(/^# .+\n+/, '') }
}

const full: Article[] = []
const restricted: Article[] = []
for (const name of readdirSync(DIR).filter((n) => /^\d\d-.+\.md$/.test(n)).sort()) {
  const text = readFileSync(join(DIR, name), 'utf8')
  const problems = markerProblems(text, name)
  if (problems.length) throw new Error(problems.join('\n'))
  const slug = name.slice(3, -3)
  full.push(article(slug, fullText(text), name))
  const kept = restrictedText(text)
  if (kept !== null) restricted.push(article(slug, kept, name))
}

const server = [
  '// generated by scripts/gen-help-articles.mts — do not edit. Regenerate: npm run help:articles.',
  'export interface HelpArticle { slug: string; title: string; body: string }',
  '/** Without website-only text: for App Store builds and any caller that does not say. */',
  `export const HELP_ARTICLES: HelpArticle[] = ${JSON.stringify(restricted, null, 2)}`,
  '/** Every article in full: for the website and the direct Mac build. */',
  `export const HELP_ARTICLES_WEB: HelpArticle[] = ${JSON.stringify(full, null, 2)}`,
  '',
].join('\n')

const outputs: [string, string][] = [
  [SERVER, server],
  [APP, `${JSON.stringify(restricted, null, 2)}\n`],
  [APP_WEB, `${JSON.stringify(full, null, 2)}\n`],
]
if (CHECK) {
  const drifted = outputs.filter(([path, text]) => !existsSync(path) || readFileSync(path, 'utf8') !== text)
  if (drifted.length) {
    for (const [path] of drifted) console.error(`help articles drifted: ${path.slice(ROOT.length)}`)
    console.error('run: npm run help:articles')
    process.exit(1)
  }
  console.log(`help articles — in sync (${restricted.length} for App Store builds, ${full.length} in full).`)
} else {
  for (const [path, text] of outputs) writeFileSync(path, text)
  console.log(`wrote ${restricted.length} help articles for App Store builds and ${full.length} in full, to the support function and the app.`)
}
