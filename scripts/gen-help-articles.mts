// The help articles, generated from apps/longbook-site-content/help/*.md: the support
// function's knowledge and the app's article reader read the same files. Committed and
// CI-checked. Regenerate: npm run help:articles.
import { readdirSync, readFileSync, writeFileSync, existsSync } from 'node:fs'
import { join } from 'node:path'
import { fileURLToPath } from 'node:url'

const ROOT = fileURLToPath(new URL('..', import.meta.url))
const DIR = join(ROOT, 'apps/longbook-site-content/help')
const SERVER = join(ROOT, 'supabase/functions/_shared/help-articles.ts')
const APP = join(ROOT, 'apps/longbook/Resources/help-articles.json')
const CHECK = process.argv.includes('--check')

interface Article { slug: string; title: string; body: string }

const articles: Article[] = readdirSync(DIR).filter((n) => /^\d\d-.+\.md$/.test(n)).sort().map((name) => {
  const text = readFileSync(join(DIR, name), 'utf8').trim()
  const title = text.match(/^# (.+)$/m)?.[1]?.trim()
  if (!title) throw new Error(`${name} has no # title`)
  return { slug: name.slice(3, -3), title, body: text.replace(/^# .+\n+/, '') }
})

const server = `// generated by scripts/gen-help-articles.mts — do not edit. Regenerate: npm run help:articles.\nexport interface HelpArticle { slug: string; title: string; body: string }\nexport const HELP_ARTICLES: HelpArticle[] = ${JSON.stringify(articles, null, 2)}\n`
const app = `${JSON.stringify(articles, null, 2)}\n`

const outputs: [string, string][] = [[SERVER, server], [APP, app]]
if (CHECK) {
  const drifted = outputs.filter(([path, text]) => !existsSync(path) || readFileSync(path, 'utf8') !== text)
  if (drifted.length) {
    for (const [path] of drifted) console.error(`help articles drifted: ${path.slice(ROOT.length)}`)
    console.error('run: npm run help:articles')
    process.exit(1)
  }
  console.log(`help articles — in sync (${articles.length}).`)
} else {
  for (const [path, text] of outputs) writeFileSync(path, text)
  console.log(`wrote ${articles.length} help articles to the support function and the app.`)
}
