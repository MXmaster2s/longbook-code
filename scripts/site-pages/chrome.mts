// One header and one footer for every page. The hand-written pages keep their own content;
// only the regions between these markers belong to the generator.
export const HEADER_BEGIN = '<!-- chrome:header — generated by scripts/gen-site-pages.mts -->'
export const HEADER_END = '<!-- /chrome:header -->'
export const FOOTER_BEGIN = '<!-- chrome:footer — generated by scripts/gen-site-pages.mts -->'
export const FOOTER_END = '<!-- /chrome:footer -->'
export const HEAD_BEGIN = '<!-- generated head — scripts/gen-site-pages.mts -->'
export const HEAD_END = '<!-- /generated head -->'

// The element that starts at `from`, up to its matching close tag.
function element(html: string, from: number, tag: string): number {
  const re = new RegExp(`<(/?)${tag}\\b[^>]*>`, 'g')
  re.lastIndex = from
  let depth = 0
  for (let m = re.exec(html); m; m = re.exec(html)) {
    depth += m[1] ? -1 : 1
    if (depth === 0) return m.index + m[0].length
  }
  throw new Error(`unclosed <${tag}>`)
}

function region(html: string, begin: string, end: string, body: string, find: () => [number, number]): string {
  const i = html.indexOf(begin)
  if (i >= 0) {
    const j = html.indexOf(end, i)
    if (j < 0) throw new Error(`"${begin}" has no end marker`)
    return `${html.slice(0, i)}${begin}\n${body}\n${html.slice(j)}`
  }
  const [a, b] = find()
  return `${html.slice(0, a)}${begin}\n${body}\n${end}${html.slice(b)}`
}

export function wrapped(begin: string, body: string, end: string): string {
  return `${begin}\n${body}\n${end}`
}

export function stampChrome(html: string, header: string, footer: string): string {
  let out = region(html, HEADER_BEGIN, HEADER_END, header, () => {
    const a = html.indexOf('<div class="top">')
    if (a < 0) throw new Error('no <div class="top"> to replace')
    return [a, element(html, a, 'div')]
  })
  out = region(out, FOOTER_BEGIN, FOOTER_END, footer, () => {
    const a = out.indexOf('<footer>')
    if (a < 0) throw new Error('no <footer> to replace')
    return [a, element(out, a, 'footer')]
  })
  return out
}

// Cloudflare's email obfuscation rewrites every address into a link only JavaScript decodes, so an
// AI agent or any reader without scripts sees "[email protected]". It leaves alone what sits between
// these markers, and strips them. A page that places markers of its own keeps them.
export const EMAIL_OFF = '<!--email_off-->'
export const EMAIL_OFF_END = '<!--/email_off-->'
export function emailsReadable(html: string): string {
  if (html.includes(EMAIL_OFF)) return html
  const open = /<body[^>]*>/.exec(html)
  const close = html.lastIndexOf('</body>')
  if (!open || close < 0) throw new Error('no <body> to mark')
  const start = open.index + open[0].length
  return `${html.slice(0, start)}${EMAIL_OFF}${html.slice(start, close)}${EMAIL_OFF_END}${html.slice(close)}`
}

// The Markdown alternate and any structured data, just before the measurement script.
export function stampHead(html: string, body: string): string {
  return region(html, HEAD_BEGIN, HEAD_END, body, () => {
    const a = html.indexOf('<script defer src="/analytics.js"></script>')
    const at = a >= 0 ? a : html.indexOf('</head>')
    if (at < 0) throw new Error('no </head>')
    return [at, at]
  }).replace(`${HEAD_END}<script defer`, `${HEAD_END}\n<script defer`)
}
