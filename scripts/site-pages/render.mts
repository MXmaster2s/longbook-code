// The features section as HTML and as Markdown, from the parsed source. The two are built
// from the same words, so the page a person reads and the file an AI reads cannot disagree.
import { ORIGIN, DOWNLOAD, GROUPS, PROMPTS_SECTION, type About, type Automations, type Block, type Feature, type GroupId, type Screen } from './content.mts'
import { findPrompt, promptPhrase, type LongbookPrompt, type PromptGroup } from '../../packages/core/src/prompts'

export interface Picture {
  key: string
  src: string
  srcSmall: string
  width: number
  height: number
  smallWidth: number
  alt: string
  title: string
}

export interface Ctx {
  features: Feature[]
  bySlug: Map<string, Feature>
  screens: Map<string, Screen>
  picture: (key: string | null, alt: string | null) => Picture | null
  about: About
  header: string
  footer: string
  scripts: string
  jsonld: (value: object) => string
}

export const GENERATED = '<!-- generated by scripts/gen-site-pages.mts from apps/longbook-site-content — do not edit -->'

export const esc = (s: string): string => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
export const attr = (s: string): string => esc(s).replace(/"/g, '&quot;')

export const pageUrl = (slug: string): string => `${ORIGIN}/features/${slug}/`
export const mdUrl = (slug: string): string => `${ORIGIN}/features/${slug}.md`
export const groupName = (id: GroupId): string => GROUPS.find((g) => g.id === id)!.name

const KNOWN = new Set(['/', '/faq/', '/download/', '/ios/', '/automations/', '/source/', '/contact/', '/why-we-built-longbook/',
  '/privacy-policy/', '/terms/', '/mcp', '/features/', '/features/upcoming-features/', '/blog/', '/reviews/', '/help/', '/support/'])

// A link inside the copy: another feature page, a blog post, a known page of the site, or an https address.
export function checkHref(href: string, slugs: Set<string>, posts: Set<string> = new Set()): string | null {
  if (/^https:\/\/[^\s]+$/.test(href) || /^mailto:[^\s]+$/.test(href)) return null
  const f = /^\/features\/([a-z0-9-]+)\/$/.exec(href)
  if (f) return slugs.has(f[1]!) ? null : `no feature "${f[1]}"`
  const b = /^\/blog\/([a-z0-9-]+)\/$/.exec(href)
  if (b) return posts.has(b[1]!) ? null : `no blog post "${b[1]}"`
  return KNOWN.has(href) ? null : `unknown link "${href}"`
}

const LINK = /\[([^\]]+)\]\(([^)\s]+)\)/g

function spans(text: string, plain: (s: string) => string, code: (s: string) => string,
  link: (label: string, href: string) => string): string {
  return text.split(/(`[^`]+`)/).map((part) => {
    if (part.length > 1 && part.startsWith('`') && part.endsWith('`')) return code(part.slice(1, -1))
    let out = ''
    let last = 0
    for (const m of part.matchAll(LINK)) {
      out += plain(part.slice(last, m.index))
      out += link(m[1]!, m[2]!)
      last = m.index! + m[0].length
    }
    return out + plain(part.slice(last))
  }).join('')
}

const bold = (s: string): string => esc(s).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')

export function inlineHtml(text: string): string {
  return spans(text, bold, (c) => `<code>${esc(c)}</code>`, (label, href) => {
    const outward = href.startsWith('https://') ? ' rel="noopener"' : ''
    return `<a href="${attr(href)}"${outward}>${bold(label)}</a>`
  })
}

// In the Markdown copy every link is absolute, and a feature page or blog post points at its own .md.
export function absolute(href: string): string {
  if (href === '/features/') return `${ORIGIN}/features.md`
  if (href === '/blog/') return `${ORIGIN}/blog.md`
  const f = /^\/features\/([a-z0-9-]+)\/$/.exec(href)
  if (f) return mdUrl(f[1]!)
  const b = /^\/blog\/([a-z0-9-]+)\/$/.exec(href)
  if (b) return `${ORIGIN}/blog/${b[1]}.md`
  return href.startsWith('/') ? `${ORIGIN}${href}` : href
}

export function inlineMd(text: string): string {
  return spans(text, (s) => s, (c) => `\`${c}\``, (label, href) => `[${label}](${absolute(href)})`)
}

export function plainText(text: string): string {
  return spans(text, (s) => s.replace(/\*\*([^*]+)\*\*/g, '$1'), (c) => c, (label) => label.replace(/\*\*/g, ''))
}

export function linksIn(text: string): string[] {
  return [...text.matchAll(LINK)].map((m) => m[2]!)
}

function blockHtml(p: string, cls = ''): string {
  const c = cls ? ` class="${cls}"` : ''
  if (p.startsWith('- ')) {
    const items = p.split('\n').map((l) => `<li>${inlineHtml(l.slice(2))}</li>`).join('')
    return `<ul${c}>${items}</ul>`
  }
  return `<p${c}>${inlineHtml(p)}</p>`
}

const APPLE = '<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.8c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9s-1.8-.9-3-.8c-1.5 0-2.9.9-3.7 2.3-1.6 2.7-.4 6.8 1.1 9 .8 1.1 1.7 2.3 2.9 2.2 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.2 0 2-1.1 2.8-2.2.9-1.3 1.2-2.5 1.3-2.6-.1 0-2.5-1-2.5-3.5zM14.2 5.9c.6-.8 1.1-1.9 1-3-1 0-2.1.6-2.8 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.8-1.5z"/></svg>'

export function downloads(where: string): string {
  return `<div class="acts" data-cta="${where}">` +
    `<a class="btn" href="${DOWNLOAD}" rel="noopener">${APPLE}Download for Mac</a>` +
    `<a class="btn ghost" href="${DOWNLOAD}" rel="noopener">${APPLE}Download for iPhone</a></div>`
}

export const platformLine = (f: Feature): string =>
  f.platforms.length === 2 ? 'iPhone and Mac' : f.platforms[0] === 'iphone' ? 'iPhone' : 'Mac'

function img(p: Picture, sizes: string, eager: boolean): string {
  const load = eager ? 'fetchpriority="high"' : 'loading="lazy"'
  return `<img src="${p.src}" srcset="${p.srcSmall} ${p.smallWidth}w, ${p.src} ${p.width}w" sizes="${sizes}" ` +
    `width="${p.width}" height="${p.height}" alt="${attr(p.alt)}" ${load} decoding="async">`
}

function macWindow(p: Picture | null, sizes: string, eager: boolean, full = false): string {
  const cls = ['scr', full ? 'full' : '', p ? '' : 'empty'].filter(Boolean).join(' ')
  return `<div class="macwin"><div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>` +
    `<div class="${cls}">${p ? img(p, sizes, eager) : ''}</div></div>`
}

function phone(p: Picture | null, sizes: string, eager: boolean): string {
  return `<div class="iph"><div class="glass${p ? '' : ' empty'}">${p ? img(p, sizes, eager) : ''}</div></div>`
}

function devices(f: Feature, ctx: Ctx, eager = true): string {
  const onPhone = f.platforms.includes('iphone')
  const onMac = f.platforms.includes('mac')
  const iphone = onPhone ? ctx.picture(f.iphone, f.iphoneAlt) : null
  const mac = onMac ? ctx.picture(f.mac, f.macAlt) : null
  const layout = onPhone && onMac ? 'duo' : onPhone ? 'solo-iph' : 'solo-mac'
  const parts = [
    onMac ? macWindow(mac, '(max-width: 900px) 80vw, 560px', eager) : '',
    onPhone ? phone(iphone, '(max-width: 900px) 34vw, 220px', eager) : '',
  ]
  return `<div class="devices ${layout}">${parts.join('')}</div>`
}

function thumb(f: Feature, ctx: Ctx): string {
  if (f.platforms.includes('iphone')) {
    return `<div class="thumb">${phone(ctx.picture(f.iphone, f.iphoneAlt), '180px', false)}</div>`
  }
  return `<div class="thumb mac">${macWindow(ctx.picture(f.mac, f.macAlt), '300px', false)}</div>`
}

export function card(f: Feature, ctx: Ctx, heading: 'h2' | 'h3'): string {
  return `<a class="fcard" href="/features/${f.slug}/" data-group="${f.group}">${thumb(f, ctx)}` +
    `<div class="cbody"><span class="chip">${esc(groupName(f.group))}</span>` +
    `<${heading}>${esc(f.title)}</${heading}><p class="ctext">${esc(f.card)}</p>` +
    `<p class="plat">${platformLine(f)}</p></div></a>`
}

const APPEARANCE = `<script>
  /* Dark is the default; a visitor's own choice, once made, is what this browser keeps.
     It runs in the head so the page never paints light first. */
  (function () {
    var m = 'dark';
    try { if (localStorage.getItem('lb-appearance') === 'light') m = 'light'; } catch (e) {}
    document.documentElement.setAttribute('data-appearance', m);
  })();
</script>`

export interface Head {
  title: string
  description: string
  canonical: string
  markdown: string
  ogTitle: string
  ogImage: string
  ogAlt: string
  jsonld: string
  /** An article's og:type and its article: tags; every other page is a website. */
  article?: { published: string; modified: string }
}

function head(h: Head): string {
  return [
    '<!doctype html>',
    GENERATED,
    '<html lang="en">',
    '<head>',
    '<meta charset="utf-8">',
    '<meta name="viewport" content="width=device-width, initial-scale=1">',
    `<title>${esc(h.title)}</title>`,
    `<meta name="description" content="${attr(h.description)}">`,
    `<link rel="canonical" href="${h.canonical}">`,
    `<link rel="alternate" type="text/markdown" href="${h.markdown}">`,
    `<meta property="og:type" content="${h.article ? 'article' : 'website'}">`,
    '<meta property="og:site_name" content="longbook">',
    `<meta property="og:url" content="${h.canonical}">`,
    `<meta property="og:title" content="${attr(h.ogTitle)}">`,
    `<meta property="og:description" content="${attr(h.description)}">`,
    `<meta property="og:image" content="${h.ogImage}">`,
    '<meta property="og:image:width" content="1200">',
    '<meta property="og:image:height" content="630">',
    `<meta property="og:image:alt" content="${attr(h.ogAlt)}">`,
    ...(h.article ? [`<meta property="article:published_time" content="${h.article.published}">`,
      `<meta property="article:modified_time" content="${h.article.modified}">`] : []),
    '<meta name="twitter:card" content="summary_large_image">',
    '<meta name="twitter:site" content="@rohthebuilder">',
    '<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">',
    '<link rel="apple-touch-icon" href="/apple-touch-icon.png">',
    '<link rel="stylesheet" href="/tokens.css">',
    '<link rel="stylesheet" href="/features/features.css">',
    APPEARANCE,
    h.jsonld,
    '<script defer src="/analytics.js"></script>',
    '</head>',
  ].join('\n')
}

export function aboutSection(ctx: Ctx): string {
  return `<section class="fsec fabout" aria-labelledby="about-longbook">` +
    `<h2 id="about-longbook">About longbook</h2>${ctx.about.body.map((p) => blockHtml(p)).join('')}` +
    `${downloads('about')}</section>`
}

export function page(h: Head, main: string, ctx: Ctx): string {
  return `${head(h)}\n<body>\n${ctx.header}\n${main}\n${ctx.footer}\n${ctx.scripts}</body>\n</html>\n`
}

/** Where site:media writes a feature's film and its poster frame. */
export const filmPath = (slug: string, ext: 'mp4' | 'jpg'): string => `/features/media/${slug}.${ext}`

export function featurePage(f: Feature, ctx: Ctx, jsonld: object): string {
  const g = groupName(f.group)
  const macPicture = f.platforms.includes('mac') ? ctx.picture(f.mac, f.macAlt) : null
  const anyPicture = (f.platforms.includes('iphone') && ctx.picture(f.iphone, f.iphoneAlt)) || macPicture
  const caption = anyPicture ? `<figcaption>${f.screen.map((p) => inlineHtml(p)).join(' ')}</figcaption>` : ''
  const does = f.does.map((b) => `<div class="col"><h3>${esc(b.title)}</h3>${b.body.map((p) => blockHtml(p)).join('')}</div>`)
  const macSection = macPicture
    ? `<section class="fsec fmac" aria-label="${attr(`${f.title} on Mac`)}"><figure>` +
      `${macWindow(macPicture, '(max-width: 960px) 92vw, 880px', false, true)}` +
      `<figcaption>${esc(ctx.screens.get(f.mac!)!.title)}</figcaption></figure></section>`
    : ''
  const questions = f.questions.length
    ? `<section class="fsec fqa" aria-labelledby="questions"><h2 id="questions">Questions</h2><div class="qa">` +
      f.questions.map((q) => `<details><summary class="lb-body">${esc(q.title)}<span class="pl">+</span></summary>` +
        `<div class="ans">${q.body.map((p) => blockHtml(p)).join('')}</div></details>`).join('') +
      '</div></section>'
    : ''
  const related = f.related.map((s) => card(ctx.bySlug.get(s)!, ctx, 'h3')).join('')
  // A film plays only when asked: sound on, no autoplay, nothing fetched before the play button.
  const film = f.film
    ? `<section class="fsec ffilm" aria-label="${attr(f.film)}"><div class="film">` +
      `<video controls playsinline preload="none" width="1280" height="720" poster="${filmPath(f.slug, 'jpg')}" aria-label="${attr(f.film)}">` +
      `<source src="${filmPath(f.slug, 'mp4')}" type="video/mp4"></video></div></section>`
    : ''
  const main = [
    `<main class="fp" data-group="${f.group}"><div class="fwrap">`,
    `<nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/features/">Features</a></li>` +
      `<li><a href="/features/#${f.group}">${esc(g)}</a></li><li aria-current="page">${esc(f.title)}</li></ol></nav>`,
    `<section class="fhero"><div class="ftext"><p class="chip">${esc(g)}</p><h1>${esc(f.title)}</h1>` +
      `${f.summary.map((p) => blockHtml(p, 'lead')).join('')}${downloads('hero')}` +
      `<p class="plat">longbook for ${platformLine(f)}</p></div>` +
      `<figure class="fdev">${devices(f, ctx)}${caption}</figure></section>`,
    film,
    `<section class="fsec fwhat" aria-labelledby="what-it-does"><h2 id="what-it-does">What it does</h2>` +
      `<div class="cols n${f.does.length}">${does.join('')}</div></section>`,
    macSection,
    `<section class="fsec fwhy" aria-labelledby="why-it-exists"><h2 id="why-it-exists">Why it exists</h2>` +
      `${f.why.map((p) => blockHtml(p)).join('')}</section>`,
    questions,
    `<section class="fsec frel" aria-labelledby="related-features"><h2 id="related-features">Related features</h2>` +
      `<div class="cards">${related}</div><p class="allf"><a href="/features/">All features of longbook</a></p></section>`,
    aboutSection(ctx),
    '</div></main>',
  ].filter(Boolean).join('\n')
  return page({
    title: `${f.seoTitle} — longbook`,
    description: f.description,
    canonical: pageUrl(f.slug),
    markdown: mdUrl(f.slug),
    ogTitle: `${f.title} — longbook`,
    ogImage: `${ORIGIN}/og/features/${f.slug}.jpg`,
    ogAlt: `${f.title}: longbook for ${platformLine(f)}`,
    jsonld: ctx.jsonld(jsonld),
  }, main, ctx)
}

export const INDEX = {
  title: 'Features of longbook',
  lead: 'Every feature of longbook for iPhone and Mac, each on its own page.',
  description: 'Every feature of longbook for iPhone and Mac: subscriptions and expenses, spending insights, monthly reports, bank statement import, and automation with your AI.',
}

// Planned features have no screenshots to show, so they are one card that leads to their own page.
const UPCOMING = { href: '/features/upcoming-features/', title: 'Upcoming features',
  text: 'Income, Available to spend and Savings accounts: what longbook plans next, as designs.' }

export function indexPage(ctx: Ctx, jsonld: object): string {
  const counts = GROUPS.map((g) => ({ ...g, n: ctx.features.filter((f) => f.group === g.id).length }))
  const side = [`<a href="#all">All features <span>${ctx.features.length}</span></a>`,
    ...counts.map((g) => `<a href="#${g.id}">${esc(g.name)} <span>${g.n}</span></a>`),
    `<a href="${UPCOMING.href}">Upcoming <span>3</span></a>`].join('')
  const groups = counts.map((g) => `<section class="igroup" id="${g.id}" data-group="${g.id}" aria-labelledby="h-${g.id}">` +
    `<h2 id="h-${g.id}">${esc(g.name)}</h2><div class="cards">` +
    ctx.features.filter((f) => f.group === g.id).map((f) => card(f, ctx, 'h3')).join('') + '</div></section>').join('\n') +
    `\n<section class="igroup" id="upcoming" data-group="upcoming" aria-labelledby="h-upcoming"><h2 id="h-upcoming">Upcoming</h2><div class="cards">` +
    `<a class="fcard" href="${UPCOMING.href}" data-group="upcoming"><div class="cbody"><span class="chip">Planned</span>` +
    `<h3>${UPCOMING.title}</h3><p class="ctext">${esc(UPCOMING.text)}</p></div></a></div></section>`
  const main = [
    '<main class="ip">',
    `<section class="ihero"><h1>${INDEX.title}</h1><p class="lead">${esc(INDEX.lead)}</p></section>`,
    '<div class="fwrap">',
    `<div class="ilay"><nav class="iside" aria-label="Feature groups">${side}</nav>`,
    `<div class="igroups" id="all">\n${groups}\n</div></div>`,
    aboutSection(ctx),
    '</div></main>',
  ].join('\n')
  return page({
    title: `${INDEX.title} — iPhone and Mac`,
    description: INDEX.description,
    canonical: `${ORIGIN}/features/`,
    markdown: `${ORIGIN}/features.md`,
    ogTitle: INDEX.title,
    ogImage: `${ORIGIN}/og/features.jpg`,
    ogAlt: 'Features of longbook for iPhone and Mac',
    jsonld: ctx.jsonld(jsonld),
  }, main, ctx)
}

function mdBlock(p: string): string {
  return p.startsWith('- ') ? p.split('\n').map((l) => `- ${inlineMd(l.slice(2))}`).join('\n') : inlineMd(p)
}

export function aboutMd(ctx: Ctx): string[] {
  return ['## About longbook', '', ...ctx.about.body.flatMap((p) => [mdBlock(p), '']),
    `- Download for Mac: ${DOWNLOAD}`, `- Download for iPhone: ${DOWNLOAD}`, '']
}

export const picturesOf = (f: Feature, ctx: Ctx): Picture[] =>
  [f.platforms.includes('iphone') ? ctx.picture(f.iphone, f.iphoneAlt) : null,
    f.platforms.includes('mac') ? ctx.picture(f.mac, f.macAlt) : null].filter((p): p is Picture => !!p)

export function featureMarkdown(f: Feature, ctx: Ctx): string {
  const pics = picturesOf(f, ctx)
  const out = [
    `# ${f.title}`, '',
    ...f.summary.flatMap((p) => [`> ${inlineMd(p)}`, '']),
    `- Page: ${pageUrl(f.slug)}`,
    `- Group: ${groupName(f.group)}`,
    `- Platforms: ${platformLine(f)}`, '',
    '## On the screen', '',
    ...f.screen.flatMap((p) => [mdBlock(p), '']),
    ...pics.flatMap((p) => [`![${p.alt}](${ORIGIN}${p.src})`, '']),
    ...(f.film ? [`[${f.film}](${ORIGIN}${filmPath(f.slug, 'mp4')})`, ''] : []),
    '## What it does', '',
    ...f.does.flatMap((b) => [`### ${b.title}`, '', ...b.body.flatMap((p) => [mdBlock(p), ''])]),
    '## Why it exists', '',
    ...f.why.flatMap((p) => [mdBlock(p), '']),
    ...(f.questions.length
      ? ['## Questions', '', ...f.questions.flatMap((q) => [`### ${q.title}`, '', ...q.body.flatMap((p) => [mdBlock(p), ''])])]
      : []),
    '## Related features', '',
    ...f.related.map((s) => {
      const r = ctx.bySlug.get(s)!
      return `- [${r.title}](${mdUrl(r.slug)}): ${r.card}`
    }),
    `- [All features of longbook](${ORIGIN}/features.md)`, '',
    ...aboutMd(ctx),
  ]
  return out.join('\n').replace(/\n{3,}/g, '\n\n').trimEnd() + '\n'
}

export function indexMarkdown(ctx: Ctx): string {
  const out = [`# ${INDEX.title}`, '', `> ${INDEX.lead}`, '', `- Page: ${ORIGIN}/features/`, '']
  for (const g of GROUPS) {
    out.push(`## ${g.name}`, '')
    for (const f of ctx.features.filter((x) => x.group === g.id)) {
      out.push(`- [${f.title}](${mdUrl(f.slug)}): ${f.card} (${platformLine(f)})`)
    }
    out.push('')
  }
  out.push('## Upcoming', '', `- [${UPCOMING.title}](${ORIGIN}${UPCOMING.href.slice(0, -1)}.md): ${UPCOMING.text}`, '')
  out.push(...aboutMd(ctx))
  return out.join('\n').replace(/\n{3,}/g, '\n\n').trimEnd() + '\n'
}

// The automations page: each automation beside its screens with a link to its own page, then how
// to connect an AI and the tools it gets. An automation with no screenshot yet shows its text alone.
export const AUTOMATIONS_URL = `${ORIGIN}/automations/`
export const sectionId = (title: string): string =>
  title.toLowerCase().replace(/['’]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')

// A paragraph that is one piece of code, such as an address or a command, shows in a box with its own
// Copy button; any other paragraph is plain text.
const CODE_ONLY = /^`([^`]+)`$/
const textOrCopy = (p: string): string => {
  const c = CODE_ONLY.exec(p)
  return c ? `<div class="copy"><code>${esc(c[1]!)}</code><button class="cbtn" type="button" data-copy="${attr(c[1]!)}">Copy</button></div>` : blockHtml(p)
}

const rows = (blocks: Block[]): string => `<dl class="rows">${blocks.map((b) =>
  `<div${b.group ? ' class="rgroup"' : ''}><dt>${esc(b.title)}</dt><dd>${b.body.map(textOrCopy).join('')}</dd></div>`).join('')}</dl>`

// The prompt catalogue (packages/core/src/prompts.ts) as the automations page lists it: by group,
// each prompt's words to copy with what it does beneath.
export interface PromptCatalogue {
  groups: PromptGroup[]
  prompts: LongbookPrompt[]
}

const NEEDS: Record<string, string> = { mail: 'a mail connector', scheduler: 'scheduled tasks' }
export const promptNeeds = (p: LongbookPrompt): string | null =>
  p.needs?.length ? `Needs ${p.needs.map((n) => NEEDS[n] ?? n).join(' and ')} in your AI.` : null

const promptGroups = (c: PromptCatalogue): (PromptGroup & { prompts: LongbookPrompt[] })[] =>
  c.groups.map((g) => ({ ...g, prompts: c.prompts.filter((p) => p.group === g.id) })).filter((g) => g.prompts.length)

export function promptsHtml(c: PromptCatalogue): string {
  return `<dl class="rows aprompts">${promptGroups(c).map((g) =>
    `<div id="prompts-${g.id}"><dt>${esc(g.title)}</dt><dd><ul class="plist">${g.prompts.map((p) => {
      const words = promptPhrase(p)
      const needs = promptNeeds(p)
      const template = p.template ? ` data-template="${attr(p.template)}"` : ''
      return `<li data-prompt="${attr(p.id)}"><div class="copy prompt"><code>${esc(words)}</code>` +
        `<button class="cbtn" type="button" data-copy="${attr(words)}"${template} aria-label="${attr(`Copy the prompt: ${p.title}`)}">Copy</button></div>` +
        `<p>${esc(p.result)}</p>${needs ? `<p class="pneeds">${esc(needs)}</p>` : ''}</li>`
    }).join('')}</ul></dd></div>`).join('')}</dl>`
}

export function promptsMarkdown(c: PromptCatalogue): string[] {
  return promptGroups(c).flatMap((g) => [`### ${g.title}`, '', ...g.prompts.map((p) => {
    const needs = promptNeeds(p)
    return `- "${promptPhrase(p)}": ${p.result}${needs ? ` ${needs}` : ''}`
  }), ''])
}

const NAMED: Record<string, string> = { quot: '"', apos: "'", lt: '<', gt: '>', nbsp: ' ', lsquo: '‘', rsquo: '’', ldquo: '“', rdquo: '”' }
const unesc = (s: string): string => s
  .replace(/&#x([0-9a-f]+);/gi, (_, h: string) => String.fromCodePoint(parseInt(h, 16)))
  .replace(/&#(\d+);/g, (_, d: string) => String.fromCodePoint(Number(d)))
  .replace(/&([a-z]+);/g, (whole, n: string) => NAMED[n] ?? whole)
  .replace(/&amp;/g, '&')

// Quoted words as a reader takes them: curly apostrophes straight, closing punctuation dropped.
const quoteForm = (s: string): string => s.replace(/[‘’]/g, "'").trim().replace(/[\s.,;:!?…]+$/, '')

const MONTHS = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september',
  'october', 'november', 'december']

/** Whether words are a prompt's template with a month named in its slot, in any case. */
export function fillsTemplate(p: LongbookPrompt, words: string): boolean {
  if (!p.template) return false
  const parts = quoteForm(p.template).split('{month}')
  if (parts.length !== 2) return false
  const [before, after] = parts as [string, string]
  const w = quoteForm(words)
  if (w.length <= before.length + after.length) return false
  return w.startsWith(before) && w.endsWith(after) && MONTHS.includes(w.slice(before.length, w.length - after.length).toLowerCase())
}

/**
 * Whether words are a prompt in the catalogue's words: a phrase, or the template with a month named.
 * A quote in the copy may also be the title, which Claude's prompt menu shows; a Copy button may not.
 */
export function inCatalogueWords(p: LongbookPrompt, words: string, quoted: boolean): boolean {
  const w = quoteForm(words)
  return [...p.phrases, ...(quoted ? [p.title] : [])].some((x) => quoteForm(x) === w) || fillsTemplate(p, words)
}

// The build fails on what this returns: a catalogue prompt the page or its Markdown copy leaves
// out, shows twice or copies with other words, and a prompt on the page the catalogue lacks. A
// month prompt may show its example or its template with another month named.
export function promptsOmitted(html: string, md: string, c: PromptCatalogue): string[] {
  const out: string[] = []
  const items = new Map<string, string[]>()
  for (const m of html.matchAll(/<li data-prompt="([^"]+)">([\s\S]*?)<\/li>/g)) items.set(m[1]!, [...(items.get(m[1]!) ?? []), m[2]!])
  const listed = [...md.matchAll(/^- "([^"]+)": /gm)].map((m) => m[1]!)
  for (const p of c.prompts) {
    const words = promptPhrase(p)
    const fits = (s: string | undefined): boolean => s !== undefined && (s === words || fillsTemplate(p, s))
    const shown = items.get(p.id) ?? []
    if (!shown.length) out.push(`the page omits the prompt "${p.id}"`)
    else if (shown.length > 1) out.push(`the page shows the prompt "${p.id}" ${shown.length} times`)
    else {
      const copied = /data-copy="([^"]*)"/.exec(shown[0]!)?.[1]
      const code = /<code>([^<]*)<\/code>/.exec(shown[0]!)?.[1]
      const [a, b] = [copied, code].map((s) => (s === undefined ? s : unesc(s)))
      if (!fits(a) || !fits(b) || a !== b) out.push(`the page does not show and copy "${words}" for "${p.id}"`)
      if (p.template && !shown[0]!.includes(`data-template="${attr(p.template)}"`)) {
        out.push(`the page does not name this month in "${p.id}"`)
      }
    }
    if (!listed.some((l) => fits(l))) out.push(`the Markdown copy omits the prompt "${p.id}"`)
  }
  const ids = new Set(c.prompts.map((p) => p.id))
  for (const id of items.keys()) if (!ids.has(id)) out.push(`the page shows a prompt "${id}" that the catalogue does not have`)
  return out
}

// Words quoted in the site's copy that name a catalogue prompt must be one of its phrases or its
// title, or its template with a month named. Quotes that name no prompt are left alone.
export function misquotedPrompts(text: string): string[] {
  const out: string[] = []
  for (const m of text.matchAll(/"([^"]+)"|“([^”]+)”/g)) {
    const words = (m[1] ?? m[2]!).trim()
    const p = findPrompt(words)
    if (!p || inCatalogueWords(p, words, true)) continue
    out.push(`quotes "${words}"; the catalogue says "${p.phrases[0]}"`)
  }
  return out
}

const BLOCK = /<\/?(?:p|div|li|ul|ol|dl|dt|dd|h[1-6]|section|article|aside|header|footer|nav|main|figure|figcaption|details|summary|table|tr|td|th|blockquote|pre|button|br|hr)\b[^>]*>/gi

/** A hand-written page's words as a reader sees them, one block to a line, without scripts or styles. */
export function pageText(html: string): string[] {
  return unesc(html.replace(/<(script|style|template)\b[\s\S]*?<\/\1>/gi, ' ').replace(/<!--[\s\S]*?-->/g, ' ')
    .replace(/\s+/g, ' ').replace(BLOCK, '\n').replace(/<[^>]+>/g, ''))
    .split('\n').map((l) => l.trim()).filter(Boolean)
}

// A hand-written page: what its Copy buttons copy and its prompt boxes show, when it names a
// catalogue prompt, is a phrase or the template with a month named; its quotes follow the copy's rule.
export function misquotedOnPage(html: string): string[] {
  const out: string[] = []
  const copied = [...html.matchAll(/\sdata-copy="([^"]*)"/g)].map((m) => unesc(m[1]!))
  const boxed = [...html.matchAll(/<[a-z]+\b[^>]*\sclass="([^"]*)"[^>]*>\s*<code\b[^>]*>([\s\S]*?)<\/code>/g)]
    .filter((m) => ['copy', 'prompt'].every((c) => m[1]!.split(/\s+/).includes(c)))
    .map((m) => unesc(m[2]!.replace(/<[^>]+>/g, '')).replace(/\s+/g, ' ').trim())
  for (const words of [...copied, ...boxed]) {
    const p = findPrompt(words)
    if (p && !inCatalogueWords(p, words, false)) out.push(`copies "${words}"; the catalogue says "${p.phrases[0]}"`)
  }
  for (const line of pageText(html)) out.push(...misquotedPrompts(line))
  return [...new Set(out)]
}

// Copy buttons put their words on the clipboard and say so for a moment. A month prompt names
// this month. If the clipboard refuses, the page tries the older copy command, then selects the
// words for the visitor to copy.
export const COPY_SCRIPT = `<script>
  (function () {
    var said = document.getElementById('said');
    var tell = function (words) { if (said) { said.textContent = ''; setTimeout(function () { said.textContent = words; }, 30); } };
    var month = new Date().toLocaleString('en', { month: 'long' });
    Array.prototype.forEach.call(document.querySelectorAll('[data-template]'), function (btn) {
      var words = btn.getAttribute('data-template').replace('{month}', month);
      var code = btn.parentNode && btn.parentNode.querySelector('code');
      btn.setAttribute('data-copy', words);
      if (code) code.textContent = words;
    });
    var legacy = function (text) {
      var t = document.createElement('textarea');
      t.value = text; t.setAttribute('readonly', ''); t.style.position = 'fixed'; t.style.top = '-1000px';
      document.body.appendChild(t); t.select();
      var ok = false; try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      t.parentNode.removeChild(t);
      return ok;
    };
    var copyText = function (text) {
      var api = navigator.clipboard && navigator.clipboard.writeText
        ? new Promise(function (resolve) { resolve(navigator.clipboard.writeText(text)); })
        : Promise.reject(new Error('no clipboard'));
      return api.catch(function () { if (!legacy(text)) throw new Error('copy blocked'); });
    };
    var select = function (node) {
      if (!node || !window.getSelection || !document.createRange) return false;
      var range = document.createRange();
      range.selectNodeContents(node);
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
      return true;
    };
    Array.prototype.forEach.call(document.querySelectorAll('[data-copy]'), function (btn) {
      var words = btn.textContent;
      var timer;
      var show = function (label, done, wait) {
        btn.textContent = label;
        btn.classList[done ? 'add' : 'remove']('done');
        clearTimeout(timer);
        timer = setTimeout(function () { btn.textContent = words; btn.classList.remove('done'); }, wait);
      };
      btn.addEventListener('click', function () {
        copyText(btn.getAttribute('data-copy')).then(function () {
          show('Copied', true, 1800);
          tell('Copied');
        }, function () {
          var picked = select(btn.parentNode && btn.parentNode.querySelector('code'));
          show('Select and copy', false, 4000);
          tell(picked ? 'Copying was blocked. The prompt is selected for you to copy.' : 'Copying was blocked. Select the text and copy it.');
        });
      });
    });
  })();
</script>
`

export function automationsPage(a: Automations, ctx: Ctx, jsonld: object, prompts: PromptCatalogue): string {
  // Sides alternate between the automations that have screens.
  let shown = 0
  const autos = a.features.map((slug) => {
    const f = ctx.bySlug.get(slug)!
    const pictured = picturesOf(f, ctx).length > 0
    const cls = ['auto', pictured ? (shown % 2 ? 'flip' : '') : 'solo'].filter(Boolean).join(' ')
    const figure = pictured ? `<figure class="fdev">${devices(f, ctx, shown++ === 0)}</figure>` : ''
    return `<section class="${cls}" id="${f.slug}" aria-labelledby="h-${f.slug}"><div class="atext">` +
      `<h2 id="h-${f.slug}">${esc(f.title)}</h2>${f.summary.map((p) => blockHtml(p, 'lead')).join('')}` +
      `<ul class="adoes">${f.does.map((b) => `<li>${esc(b.title)}</li>`).join('')}</ul>` +
      `<p class="amore"><a href="/features/${f.slug}/" aria-label="${attr(`Read more: ${f.title}`)}">Read more</a></p>` +
      `</div>${figure}</section>`
  })
  const sections = a.sections.map((s) => {
    const id = sectionId(s.title)
    return `<section class="fsec aconn" id="${id}" aria-labelledby="h-${id}"><h2 id="h-${id}">${esc(s.title)}</h2>` +
      `${s.intro.map(textOrCopy).join('')}${s.blocks.length ? rows(s.blocks) : ''}` +
      `${s.title === PROMPTS_SECTION ? promptsHtml(prompts) : ''}</section>`
  })
  const jump = a.sections.map((s) => `<a href="#${sectionId(s.title)}">${esc(s.title)}</a>`).join('')
  const main = [
    '<main class="ap" data-group="automate">',
    `<section class="ihero"><h1>${esc(a.title)}</h1>${a.summary.map((p) => blockHtml(p, 'lead')).join('')}` +
      `<nav class="ajump" aria-label="On this page">${jump}</nav></section>`,
    '<div class="fwrap">',
    ...autos,
    ...sections,
    aboutSection(ctx),
    '</div>',
    '<p class="sr" aria-live="polite" id="said"></p>',
    '</main>',
  ].join('\n')
  return page({
    title: `${a.seoTitle} — longbook`,
    description: a.description,
    canonical: AUTOMATIONS_URL,
    markdown: `${ORIGIN}/automations.md`,
    ogTitle: `${a.title} — longbook`,
    ogImage: `${ORIGIN}/og/automations.jpg`,
    ogAlt: `${a.title}: longbook for iPhone and Mac`,
    jsonld: ctx.jsonld(jsonld),
  }, main, { ...ctx, scripts: `${ctx.scripts}${COPY_SCRIPT}` })
}

export function automationsMarkdown(a: Automations, ctx: Ctx, prompts: PromptCatalogue): string {
  const out = [`# ${a.title}`, '', ...a.summary.flatMap((p) => [`> ${inlineMd(p)}`, '']), `- Page: ${AUTOMATIONS_URL}`, '']
  for (const slug of a.features) {
    const f = ctx.bySlug.get(slug)!
    out.push(`## ${f.title}`, '', ...f.summary.flatMap((p) => [mdBlock(p), '']),
      ...f.does.map((b) => `- ${b.title}`), '',
      ...picturesOf(f, ctx).flatMap((p) => [`![${p.alt}](${ORIGIN}${p.src})`, '']),
      `Read more: [${f.title}](${mdUrl(f.slug)})`, '')
  }
  for (const s of a.sections) {
    out.push(`## ${s.title}`, '', ...s.intro.flatMap((p) => [mdBlock(p), '']),
      ...s.blocks.flatMap((b, i) => [`${b.group ? '###' : s.blocks.slice(0, i).some((g) => g.group) ? '####' : '###'} ${b.title}`, '', ...b.body.flatMap((p) => [mdBlock(p), ''])]),
      ...(s.title === PROMPTS_SECTION ? promptsMarkdown(prompts) : []))
  }
  out.push(...aboutMd(ctx))
  return out.join('\n').replace(/\n{3,}/g, '\n\n').trimEnd() + '\n'
}
