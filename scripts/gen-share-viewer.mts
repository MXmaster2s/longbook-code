// The shared-report viewer's script, generated: bundles r/viewer.src.mts and writes it inline
// into r/index.html between its markers, with tokens.css linked by content hash. Inline, so a
// cached script can never meet a newer page. Committed and CI-checked.
import { buildSync } from 'esbuild'
import { createHash } from 'node:crypto'
import { readFileSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'
import { fileURLToPath } from 'node:url'

const ROOT = fileURLToPath(new URL('..', import.meta.url))
const SITE = join(ROOT, 'apps/longbook-site')
const SRC = join(SITE, 'r/viewer.src.mts')
const PAGE = join(SITE, 'r/index.html')
const TOKENS = join(SITE, 'tokens.css')
const BEGIN = '<!-- viewer:begin -->'
const END = '<!-- viewer:end -->'
const CHECK = process.argv.includes('--check')

function fail(message: string): never {
  console.error(message)
  process.exit(1)
}

const bundle = (buildSync({
  entryPoints: [SRC],
  bundle: true,
  format: 'iife',
  platform: 'browser',
  target: 'es2020',
  minify: true,
  legalComments: 'none',
  write: false,
}).outputFiles[0]?.text ?? '').trimEnd()

// Either would end or garble the script element the bundle is written into.
if (/<\/script|<!--/i.test(bundle)) fail('viewer bundle holds "</script" or "<!--"; it cannot sit inline.')

const current = readFileSync(PAGE, 'utf8')
const from = current.indexOf(BEGIN)
const to = current.indexOf(END)
if (from < 0 || to < from) fail(`r/index.html has lost its ${BEGIN} … ${END} markers.`)

const script = '<script>\n// generated by scripts/gen-share-viewer.mts — do not edit. Regenerate: npm run site:viewer.\n' +
  `${bundle}\n</script>\n`
const stamp = createHash('sha256').update(readFileSync(TOKENS)).digest('hex').slice(0, 10)
const link = /href="\/tokens\.css(?:\?v=[0-9a-f]+)?"/g
const withScript = `${current.slice(0, from + BEGIN.length)}\n${script}${current.slice(to)}`
if (!link.test(withScript)) fail('r/index.html no longer links /tokens.css.')
const next = withScript.replace(link, `href="/tokens.css?v=${stamp}"`)

if (CHECK) {
  if (next !== current) {
    console.error('shared-report viewer drifted: apps/longbook-site/r/index.html')
    fail('run: npm run site:viewer')
  }
  console.log('shared-report viewer — in sync.')
} else {
  writeFileSync(PAGE, next)
  console.log(`wrote apps/longbook-site/r/index.html (script ${Math.round(bundle.length / 1024)} KB, tokens.css?v=${stamp}).`)
}
