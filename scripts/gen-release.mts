#!/usr/bin/env -S npx tsx
// Stamps the release number into the files that carry it: the servers' reported version, the npm
// package and its MCP registry entry. Run: npm run release; --check fails on any difference.
import { readFileSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'
import { MCP_NAME, NPM_NAME, RELEASE_VERSION, ROOT, RULEBOOK } from './release.mts'

const CHECK = process.argv.includes('--check')

const releaseTs = [
  '// generated by scripts/gen-release.mts — do not edit. Regenerate: npm run release.',
  '// The release number both MCP servers report, 1.<rulebook revision>.<patch>.',
  `export const RELEASE_VERSION = '${RELEASE_VERSION}'`,
  '',
].join('\n')

const pkgPath = join(ROOT, 'packages/mcp/package.json')
const pkg = JSON.parse(readFileSync(pkgPath, 'utf8')) as Record<string, unknown>
const { private: _private, ...rest } = pkg
const nextPkg = {
  name: NPM_NAME,
  version: RELEASE_VERSION,
  mcpName: MCP_NAME,
  license: 'GPL-3.0-only',
  // The npm registry cuts a description at 255 characters, so the claim line must sit inside that.
  description:
    'The longbook MCP server: your longbook folder, readable by the AI you already use. Real arithmetic on what is ' +
    'due and what renews; changes go through the app\'s Changes screen. ' +
    // mcprush.com reads this line from the registry to verify the claim; keep it until they confirm.
    'mcprush.com-claim-longbook-mcp-5dd29bf58ce121bd23d37ac6',
  ...Object.fromEntries(Object.entries(rest).filter(([k]) => !['name', 'version', 'mcpName', 'license', 'description'].includes(k))),
  engines: { node: '>=18' },
  publishConfig: { access: 'public' },
  files: ['bin', 'README.md', 'LICENSE', 'server.json'],
}

if (nextPkg.description.length > 250) throw new Error('npm package description is over 250 characters; the registry would cut it.')

// The MCP registry entry, written whole: one server, reachable hosted or through npm.
const SERVER_JSON = {
  $schema: 'https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json',
  name: MCP_NAME,
  title: 'longbook',
  description: 'Your longbook of bills, subscriptions and expenses, for your AI to read and to suggest changes to.',
  version: RELEASE_VERSION,
  websiteUrl: 'https://longbook.app/mcp/',
  repository: { url: 'https://github.com/MXmaster2s/longbook-code', source: 'github', subfolder: 'packages/mcp' },
  icons: [{ src: 'https://longbook.app/apple-touch-icon.png', mimeType: 'image/png', sizes: ['180x180'] }],
  remotes: [{ type: 'streamable-http', url: 'https://longbook.app/mcp' }],
  packages: [
    {
      registryType: 'npm',
      identifier: NPM_NAME,
      version: RELEASE_VERSION,
      runtimeHint: 'npx',
      transport: { type: 'stdio' },
      packageArguments: [
        {
          type: 'named',
          name: '--vault',
          description: 'Your longbook folder. On a Mac it defaults to the app\'s iCloud Drive folder.',
          isRequired: false,
        },
      ],
    },
  ],
}

const files: [string, string][] = [
  ['packages/core/src/release.ts', releaseTs],
  ['packages/mcp/package.json', JSON.stringify(nextPkg, null, 2) + '\n'],
  ['packages/mcp/server.json', JSON.stringify(SERVER_JSON, null, 2) + '\n'],
  ['packages/mcp/LICENSE', readFileSync(join(ROOT, 'LICENSE'), 'utf8')],
]

let drift = 0
for (const [rel, content] of files) {
  const at = join(ROOT, rel)
  let now: string | null = null
  try { now = readFileSync(at, 'utf8') } catch { now = null }
  if (now === content) continue
  drift++
  if (CHECK) console.error(`drift: ${rel}`)
  else writeFileSync(at, content)
}
if (CHECK && drift) {
  console.error(`\nrelease ${RELEASE_VERSION} is not stamped everywhere — run: npm run release`)
  process.exit(1)
}
console.log(CHECK ? `release — ${RELEASE_VERSION} (rulebook ${RULEBOOK}) stamped everywhere.` : `release ${RELEASE_VERSION} (rulebook ${RULEBOOK}): ${drift} file(s) written.`)
