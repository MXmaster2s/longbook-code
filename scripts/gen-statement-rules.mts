#!/usr/bin/env -S npx tsx
// The statement rules as the Deno function reads them: packages/core/src/statement-rules.ts
// copied into supabase/functions/_shared/statement-rules.ts, so the cloud prompts and the
// guide say the same words. Run with --check to verify. Regenerate: npm run statement:rules.
import { readFileSync, writeFileSync, existsSync } from 'node:fs'
import { join, dirname } from 'node:path'
import { fileURLToPath } from 'node:url'
import { STATEMENT_RULE_GROUPS } from '../packages/core/src/statement-rules'

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..')
const OUT = join(ROOT, 'supabase/functions/_shared/statement-rules.ts')
const CHECK = process.argv.includes('--check')

const module_ = `// generated by scripts/gen-statement-rules.mts from packages/core/src/statement-rules.ts — do not edit. Regenerate: npm run statement:rules.
export type StatementRuleGroupId = 'reading' | 'kinds' | 'people' | 'counterparts' | 'names' | 'commitments' | 'notes' | 'accounts'
export interface StatementRule { id: string; text: string }
export interface StatementRuleGroup { id: StatementRuleGroupId; title: string; rules: StatementRule[] }
export const STATEMENT_RULE_GROUPS: StatementRuleGroup[] = ${JSON.stringify(STATEMENT_RULE_GROUPS, null, 2)}

/** One group's rules by its id. */
export function statementRules(group: StatementRuleGroupId): StatementRule[] {
  return STATEMENT_RULE_GROUPS.find((g) => g.id === group)?.rules ?? []
}

/** One group's rules as one paragraph, the way a prompt says them. */
export function statementRuleText(group: StatementRuleGroupId): string {
  return statementRules(group).map((rule) => rule.text).join(' ')
}
`

if (CHECK) {
  const current = existsSync(OUT) ? readFileSync(OUT, 'utf8') : ''
  if (current !== module_) {
    console.error(`${OUT} is stale; run npm run statement:rules`)
    process.exit(1)
  }
  console.log('statement rules are current')
} else {
  writeFileSync(OUT, module_)
  console.log(`wrote ${OUT}`)
}
