<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.longbook</string>
	</array>

	<!--
	  The app's iCloud keys, mirrored: the widget is a SEPARATE PROCESS reading the same vault,
	  and container access is granted only to a target carrying the entitlement. Read-only in
	  practice — what the grant buys is freshness after a Mac edit. See VaultMirror for the
	  fallback covering the one vault this still cannot reach.
	-->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.longbook</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.app.longbook</string>
	</array>
</dict>
</plist>
