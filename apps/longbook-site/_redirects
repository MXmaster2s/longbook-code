# Netlify redirects for longbook.app.

# The privacy policy is a real page; the short word leads to it.
/privacy                /privacy-policy/  301!
/privacy/*              /privacy-policy/  301!

# The address the owner first wrote for the Cloud page leads to it.
/feature/what-is-longbook-cloud-service  /features/what-is-longbook-cloud/  301!

# A shared report opens at the site's own page, whatever the id; the page asks the
# function for the report through the proxy below, same origin, no key in the browser.
/r/*           /r/index.html  200
/share-report  https://xbrnijgctmovoqbbmgmb.supabase.co/functions/v1/share-report  200!

# The public MCP address — a 200 proxy, never a redirect: the AI talks to longbook.app
# and Netlify carries the whole conversation to the hosted function.
/api/seats  https://xbrnijgctmovoqbbmgmb.supabase.co/functions/v1/seats  200!
/mcp    https://xbrnijgctmovoqbbmgmb.supabase.co/functions/v1/mcp         200!
/mcp/*  https://xbrnijgctmovoqbbmgmb.supabase.co/functions/v1/mcp/:splat  200!

# Where RFC 9728 says to look for a resource that has a path: the well-known segment goes
# BEFORE it, not after. A client that follows the spec rather than our challenge header
# was landing on the site's 404 page and never starting the sign-in.
/.well-known/oauth-protected-resource/mcp  https://xbrnijgctmovoqbbmgmb.supabase.co/functions/v1/mcp/.well-known/oauth-protected-resource  200!

# Pages that lived at other addresses, or do not exist yet, land where they belong.
# The site is released; only these routes still wait on something.
/home                   /         301!
/home/*                 /         301!
/github                 https://github.com/MXmaster2s/longbook-code  302!
/demo                   /         301!
/demo/*                 /         301!
/license                /terms/   301!
/license/*              /terms/   301!
/refunds                /terms/   301!
/refunds/*              /terms/   301!
/why-privacy-matters    /privacy-policy/  301!
/why-privacy-matters/*  /privacy-policy/  301!
/thank-you              /         301!
/thank-you/*            /         301!
/agentic                /automations/    301!
/agentic/*              /automations/    301!
/agentic.md             /automations.md  301!
/support                /contact/ 301!
/support/*              /contact/ 301!
/support-us             /contact/ 301!
/support-us/*           /contact/ 301!
# Both apps ship through TestFlight and the App Store. A Mac build that asks for an update
# feed, or a saved disk-image address, lands on the download page rather than a 404.
/appcast.xml            /download/  301!
/downloads/*            /download/  301!

# The iPhone beta arrives through TestFlight, which most people have never used. The
# email points here rather than at Apple, so the two steps are explained first.
/testflight             /ios/  301!
/testflight/*           /ios/  301!

/feedback               https://insigh.to/b/longbook  302!
/feedback/*             https://insigh.to/b/longbook  302!

# Source that rides along in the publish folder: the edge functions' TypeScript and the consent
# page's unbundled script. What runs is the deployed bundle; nobody needs to read the source.
/netlify/*                      /404.html  404!
/oauth/consent/consent.src.mts  /404.html  404!
/analytics.src.mts  /404.html  404!

# One canonical host: the raw Netlify hostname redirects to the apex, so no duplicate of the
# site exists and every page's ranking signals accrue to one place. Forced (`!`) — without it
# Netlify serves a matching static file first and the rule never fires. Deploy previews are a
# different host (deploy-preview-N--…) and unaffected.
http://longbook-app.netlify.app/*   https://longbook.app/:splat  301!
https://longbook-app.netlify.app/*  https://longbook.app/:splat  301!

