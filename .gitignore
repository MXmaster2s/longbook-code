# deps
node_modules/

# builds
build/
# Release binaries never enter the history; the Mac ships through the App Store.
apps/longbook-site/downloads/
dist/
*.tsbuildinfo
apps/ios/build/
DerivedData/
.build/
.swiftpm/

# generated by xcodegen from project.yml
apps/longbook/longbook.xcodeproj/
apps/longbook/Info.plist

# env / secrets
.env
.env.*
*.local.xcconfig
Signing.local.xcconfig

# machine-local operating layer (synced via the private team repo, never committed here)
CLAUDE.md
.claude/

# worktree manager
# Its config names one machine's paths. The scripts it runs live in scripts/, so anyone
# can run them without it.
jean.json

# editors / os
.DS_Store
.obsidian/
.idea/
.vscode/

# deploy state
.netlify/
# written by Netlify's CLI when it bundles the site's edge function.
deno.lock

# Store screenshots are made by the snapshot harness and edited by hand; never committed.
images/screenshots/
# The media kit's source photos, and the images scripts/media-kit.swift builds from them and
# the screenshots. media-kit/files.json names each built file; the site deploy carries them.
images/media-kit/
apps/longbook-site/media-kit/files/
# The features screenshots and share images, built on a Mac by site:images and site:og.
# apps/longbook-site-content/built.json names each one; the site deploy carries them.
apps/longbook-site/features/img/
apps/longbook-site/og/
# The website's films, re-encoded from images/videos by site:media and named in built.json.
images/videos/
apps/longbook-site/ready-for-the-run/media/
# A feature page's film and poster, built by site:media like the films above.
apps/longbook-site/features/media/
# A blog post's pictures, built by site:media like the films above.
apps/longbook-site/blog/media/
# The reviews page's share image, built by site:media like the blog's pictures.
apps/longbook-site/reviews/share.jpg
